<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- CDN kaynaklarına HTTPS ile erişim -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">cdnjs.cloudflare.com</domain>
        <domain includeSubdomains="true">unpkg.com</domain>
        <domain includeSubdomains="true">api.anthropic.com</domain>
    </domain-config>

    <!-- Varsayılan: sadece HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
